# La autenticacion (admin y usuarios) es 100% Supabase Auth.
# Un usuario es admin si tiene el rol 'admin' en la tabla user_roles.

# API keys de Challonge (solo servidor, NUNCA con prefijo NEXT_PUBLIC_).
# Cuenta A: historica (backfill unico). Cuenta B: actual/default.
# CHALLONGE_API_KEY sigue funcionando como fallback de CHALLONGE_API_KEY_B
# para no romper entornos que todavia no migraron a las claves separadas.
CHALLONGE_API_KEY=your-challonge-api-key
CHALLONGE_API_KEY_A=your-challonge-api-key-account-a
CHALLONGE_API_KEY_B=your-challonge-api-key-account-b

# Fuente de datos: "mock" (JSON local) o "supabase"
DATA_SOURCE=mock

# Supabase (requerido para auth; la capa de datos ademas cuando DATA_SOURCE=supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Clave service_role (solo servidor, para las rutas de admin que escriben en la BD)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secreto compartido con el workflow de keep-alive (.github/workflows/keep-supabase-alive.yml):
# /api/health solo registra el ping en sistema_eventos si este header coincide.
HEALTH_PING_SECRET=your-health-ping-secret

# Dominio de produccion (sin barra final), usado para metadataBase/OG y el
# sitemap. En Preview/local se puede dejar sin definir (cae a localhost).
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com
