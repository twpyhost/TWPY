{
  "name": "twpy-ranking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/guard-dev-env.mjs && next dev --turbopack",
    "dev:prod": "node scripts/guard-dev-env.mjs --permitir-prod",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:e2e": "playwright test --project=e2e",
    "test:ui": "playwright test --ui",
    "seed:torneos": "node --env-file=.env.local scripts/seed-datos-prueba.js",
    "purgar:torneos": "node --env-file=.env.local scripts/purgar-datos-prueba.js",
    "seed:liga": "node --env-file=.env.local scripts/seed-liga.js",
    "purgar:liga": "node --env-file=.env.local scripts/purgar-liga.js",
    "seed:admin": "node --env-file=.env.local scripts/seed-admin.js",
    "purgar:admin": "node --env-file=.env.local scripts/purgar-admin.js",
    "seed:todo": "npm run seed:torneos && npm run seed:liga && npm run seed:admin",
    "purgar:todo": "npm run purgar:torneos && npm run purgar:liga && npm run purgar:admin"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.48.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hot-toast": "^2.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "next": "^16.2.12",
    "postcss": "^8",
    "prettier": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "supabase": "^2.110.0",
    "tailwindcss": "^3.4.1"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  }
}
